# ----------
# Bot & Cogs
# ----------

# [REQUIRED]
# The bot's Discord application token, from the Discord Developer Portal.
BOT_TOKEN=""

# The prefix used to invoke legacy (non-slash) text commands.
BOT_PREFIX="!"

# Discord user ID of the bot owner which grants access to owner-only commands.
BOT_OWNER=

# Max seconds a deferred slash command is allowed to run before it's aborted
# with a "timed out" reply, so the "thinking..." indicator doesn't hang
# indefinitely.
COMMAND_TIMEOUT_SECONDS=10

# Interval, in seconds, between automatic AniList activity update checks.
ANILIST_UPDATE_LOOP_TIME_SECONDS=600

# Interval, in seconds, between automatic WaniKani review/lesson update checks.
WANIKANI_UPDATE_LOOP_TIME_SECONDS=3600

# Local time (HH:MM, 24h) at which the WaniKani daily summary is posted.
WANIKANI_DAILY_SUMMARY_TIME=23:59

# IANA timezone used for the WaniKani daily summary time and streak day
# boundaries.
WANIKANI_TIMEZONE=Europe/Madrid

# -------------------
# Logging & Debugging
# -------------------

# Whether logs are also written to stdout, in addition to the log files.
ENABLE_CONSOLE_LOGGING=False

# The format string used for both file and console log outputs.
LOGS_FORMAT="%(asctime)s %(levelname)s %(name)s @%(funcName)s: %(message)s"

# [REQUIRED]
# Max size, in MiB, a log file can reach before it's rotated.
LOGS_MAX_SIZE=16

# ---------------------
# Development & Testing
# ---------------------

# When true, slash commands are synced instantly to `TEST_MODE` instead of
# globally (global syncs can take up to an hour to propagate).
TEST_MODE=False

# Custom Discord guild (server) ID slash commands are synced to when `TEST_MODE`
# is enabled.
TEST_GUILD=

# ----------
# Deployment
# ----------

# Whether to use `DB_PATH` below. When false (or unset), `DB_PATH` is ignored
# and the database is always created in `chii/data/files`.
USE_DB_PATH=False

# Overrides where the SQLite database file is created. Only takes effect when
# `USE_DB_PATH` is enabled.
#
# Set this when running the bot in Docker, pointing it at a volume-mounted path
# outside the source tree so the database survives image updates.
#
# The container-side path here must match the container-side target of the
# volume mount in `docker/compose.yaml` (currently `/app/state`), otherwise the
# database won't actually live on the mounted volume and will be lost when
# the container is recreated.
DB_PATH=/app/state/chii.db
